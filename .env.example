# ============================================================================
#  Arudhya ERP — environment configuration  (.env.example)
#  Copy this file to  .env  and fill in your real values. NEVER commit .env.
#  The backend loads .env automatically on startup (backend/.env or ./.env).
# ============================================================================

# ---- Core Django ----------------------------------------------------------
# DEBUG=1 for local development, 0 in production.
DJANGO_DEBUG=1
# Generate a strong key:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated hostnames the site is served from (production).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full https origins for CSRF (production, comma-separated), e.g. https://erp.yourdomain.com
DJANGO_CSRF_TRUSTED=


# ============================================================================
#  DATABASE  (production — e.g. Render / Railway / any managed PostgreSQL)
# ----------------------------------------------------------------------------
#  Leave blank for local development (uses SQLite). In production set the full
#  connection URL from your database provider. On Render, this is injected
#  automatically when you use the Blueprint (render.yaml); otherwise paste the
#  "Internal Database URL" from your Render PostgreSQL instance.
#    postgres://USER:PASSWORD@HOST:PORT/DBNAME
# ============================================================================
DATABASE_URL=
# DB_SSLMODE=require        # default; set to 'disable' only for local Postgres

# ============================================================================
#  GMAIL NOTIFICATIONS (email to admin on every workflow event)
# ----------------------------------------------------------------------------
#  HOW TO GET A GMAIL APP PASSWORD (required — your normal password will NOT work):
#   1. Use/create a Gmail account for the lab (e.g. arudhyatestsolutions@gmail.com).
#   2. Turn ON 2-Step Verification:  https://myaccount.google.com/security
#   3. Open  https://myaccount.google.com/apppasswords
#   4. App = "Mail", Device = "Other" → name it "Arudhya ERP" → Generate.
#   5. Copy the 16-character password (no spaces) into EMAIL_HOST_PASSWORD below.
#  Leave USER/PASSWORD blank to keep the console backend (emails print to the
#  terminal — handy for local testing).
# ============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=arudhyatestsolutions@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# "From" shown on the emails (defaults to EMAIL_HOST_USER if left blank).
DEFAULT_FROM_EMAIL=arudhyatestsolutions@gmail.com

# ============================================================================
#  WHATSAPP NOTIFICATIONS
# ----------------------------------------------------------------------------
#  WHATSAPP_PROVIDER chooses how WhatsApp messages are sent:
#     link   → (default) No credentials needed. The app shows a one-tap
#              "WhatsApp admin" button that opens WhatsApp with the message
#              pre-filled (wa.me). You press Send. Great to start with.
#     cloud  → Meta WhatsApp Cloud API — messages send automatically, no tap.
#     twilio → Twilio WhatsApp API — messages send automatically, no tap.
#     none   → Disable WhatsApp entirely.
#
#  The recipient is the "Admin WhatsApp" number in the app (Settings → Lab
#  profile). Enter it in international format, e.g. +919505515816.
#  WHATSAPP_ADMIN_TO below is only a fallback if that field is left blank.
# ============================================================================
WHATSAPP_PROVIDER=link
WHATSAPP_ADMIN_TO=+919505515816

# ---- Option A: Meta WhatsApp Cloud API  (WHATSAPP_PROVIDER=cloud) ----------
#  Setup (free tier available):
#   1. Create a Meta app:  https://developers.facebook.com/apps  (type: Business)
#   2. Add the "WhatsApp" product. In API Setup you get:
#        • a temporary access token  → WHATSAPP_TOKEN
#        • a Phone number ID          → WHATSAPP_PHONE_ID
#   3. Add your admin number as a recipient (test mode) or verify a business
#      number for production. For production, generate a permanent token via a
#      System User in Business Settings.
#   NOTE: Outside the 24-hour customer window WhatsApp requires an approved
#   message *template*; within the session window plain text works. For staff
#   alerts to your own number, keep the session active or use an approved template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Option B: Twilio WhatsApp  (WHATSAPP_PROVIDER=twilio) -----------------
#  Setup:
#   1. Create a Twilio account:  https://www.twilio.com/whatsapp
#   2. From the Console copy Account SID and Auth Token.
#   3. Use the Twilio Sandbox number (join it from your phone first) or a
#      provisioned WhatsApp sender. Format: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Optional: file storage / uploads location (production) ----------------
# DJANGO_MEDIA_ROOT=/opt/arudhya-erp/backend/media
