# Copy to /opt/arudhya-erp/.env and edit. Loaded by the systemd service.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=CHANGE-ME-run:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
DJANGO_ALLOWED_HOSTS=erp.yourdomain.com
DJANGO_CSRF_TRUSTED=https://erp.yourdomain.com

# Email notifications (Gmail: use an App Password from myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=arudhyatestsolutions@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=arudhyatestsolutions@gmail.com

# ---- WhatsApp (see project-root .env.example for full setup) ----
WHATSAPP_PROVIDER=link          # link | cloud | twilio | none
WHATSAPP_ADMIN_TO=+919505515816
# Meta Cloud API:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v21.0
# Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
